func t(key: String) -> String:
	var table: Dictionary = T.get(lang, T["en"])
	if table.has(key):
		return table[key]
	var fallback: Dictionary = T["en"]
	return str(fallback.get(key, key))


func set_lang(new_lang: String) -> void:
	if not LANGS.has(new_lang) or new_lang == lang:
		return
	lang = new_lang
	language_changed.emit()


func next_lang() -> String:
	return LANGS[(LANGS.find(lang) + 1) % LANGS.size()]
